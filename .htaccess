
RewriteEngine On

RewriteBase /www/e61483u/deefy/

# Bloquer les dossiers contenant du code ou des identifiants
RewriteRule ^sql(/.*|)$ - [NC,F]
RewriteRule ^src(/.*|)$ - [NC,F]
RewriteRule ^config(/.*|)$ - [NC,F]
RewriteRule \.ini$ - [NC,F]

# Rediriger l'accueil vers public/index.php
RewriteRule ^$ public/index.php [L]
